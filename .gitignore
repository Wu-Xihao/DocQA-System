# Python bytecode, build outputs and package metadata
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/build/
/dist/

# Virtual environments
/.venv/
/venv/
/env/
/.conda/

# Secrets; sanitized example files remain versioned
.env
.env.*
!.env.example
!.env.*.example

# Machine-specific configuration; templates remain versioned
/configs/local.yaml
/configs/local.yml
/configs/local.*.yaml
/configs/local.*.yml
!/configs/local.example.yaml
!/configs/local.example.yml

# Generated knowledge assets, private source documents and local design scratch
/runtime/
/data/private/
/.design-work/
/eval/reports/raw/

# Machine-specific environment snapshots (real project lock files stay tracked)
/requirements-installed.txt
/environment-history.yml

# Test, analysis and notebook caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
/htmlcov/
/coverage.xml
/coverage.json
.ipynb_checkpoints/

# Editor-local state and operating-system files
/.idea/
/.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.log
